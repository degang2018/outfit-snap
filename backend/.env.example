# 复制为 .env 并按需修改(不提交到仓库)

# ==============================================================================
#  ⚠️ 三条路三注意:
#     本地 Python 运行 → COMFY_OUTPUT_DIR 写你本机 ComfyUI 的 output 目录
#     Docker Compose   → COMFY_API 写 http://host.docker.internal:8188
#                         COMFY_OUTPUT_DIR 写容器内路径 (先在 docker-compose.yml 挂载)
#     同时改了 .env     → 本地重启 python run.py;Docker 改完自动 reload
# ==============================================================================

# --- 数据库:开发用 SQLite (默认),生产切 MySQL ---
# DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/outfit_video?charset=utf8mb4

# --- 鉴权 (生产必须改 JWT_SECRET) ---
JWT_SECRET=please-change-this-secret
ACCESS_TOKEN_TTL_HOURS=168

# --- 跨域 (前端 dev server 用,生产默认同源不用改) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- ComfyUI ---
# 本地运行:  http://127.0.0.1:8188
# Docker 里: http://host.docker.internal:8188
COMFY_API=http://127.0.0.1:8188

# ⚠️ 必须填:ComfyUI 的 output 目录 (生成的图片/视频落在这里)
# Windows: COMFY_OUTPUT_DIR=C:/ComfyUI/ComfyUI/output
# Linux:   COMFY_OUTPUT_DIR=/home/user/ComfyUI/output
# Docker:  先在 docker-compose.yml 里把宿主机 output 挂到容器内,再写容器内路径
COMFY_OUTPUT_DIR=/path/to/your/ComfyUI/output

# --- 出片参数 ---
GEN_WIDTH=576
GEN_HEIGHT=1024
OUT_WIDTH=1080
OUT_HEIGHT=1920
FPS=24
GEN_LENGTH=124
SHOT_TIMEOUT=1800

# --- 生成偏好:衣服的「开合」(扣子 / 拉链)---
# 上衣的扣子、外套的拉链默认要不要合上:
#   auto(默认:**什么都不写**,让模型照参考图自己决定) / closed(扣上 / 拉链拉满) /
#   half(半开) / open(敞开)
# 只对**有前襟的件**生效:吊带 / 背心 / 裤 / 鞋 / 包 / 墨镜 和套头款(T恤 / 毛衣)自动跳过。
# 单件:资源管理里那张素材的「开合」下拉;某一炉临时改:一键换装第 5 栏件列表的下拉。
GARMENT_CLOSE_DEFAULT=auto

# --- 后台 worker ---
WORKER_ENABLED=1
WORKER_POLL_SECONDS=3

# --- LLM:把剧本切成镜头(默认本机 Ollama,强制 CPU 推理不抢显存) ---
LLM_ENABLED=1
LLM_API_STYLE=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
LLM_NUM_GPU=0
LLM_TIMEOUT=300
# 镜头描述与提示词正文的语言:zh(中文,默认) 或 en
LLM_PROMPT_LANG=zh
# 换成云端 OpenAI 兼容接口:
# LLM_API_STYLE=openai
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=deepseek-chat
# 读图(上传服装图 -> 自动生成剧本)用的视觉模型。DeepSeek 是 deepseek-flash
# (deepseek-chat 只吃文本);留空则退回 LLM_MODEL。
# LLM_VISION_MODEL=deepseek-flash
